// ClubFlow 数据模型 · 首版
// 权威依据：docs/PRD-通用工作流引擎.md §4.1.1 / §5.3 / §5.4 / §6.2 / FR-12.x
// 变更计划：changes/2026-11-16-db-foundation/
//
// 重要：run_events 与 audit_logs 在数据库中是按 ts 月分区的分区表。
// Prisma 无法表达 PARTITION BY，这里只声明普通模型以生成类型与查询能力，
// 物理 DDL 由手写 SQL 迁移创建。这两张表禁止使用 prisma db push / migrate 自动改表。

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
  // Prisma 7 起连接串不再写在 schema 里，见 packages/server/prisma.config.ts
}

// ===== 枚举 =====
// 值统一映射为小写，PG 中可直接写 status = 'queued'。

enum RunStatus {
  QUEUED    @map("queued")
  RUNNING   @map("running")
  WAITING   @map("waiting")
  SUCCEEDED @map("succeeded")
  FAILED    @map("failed")
  CANCELED  @map("canceled")
  TIMED_OUT @map("timed_out")

  @@map("run_status")
}

enum NodeRunStatus {
  PENDING   @map("pending")
  RUNNING   @map("running")
  WAITING   @map("waiting")
  SUCCEEDED @map("succeeded")
  FAILED    @map("failed")
  SKIPPED   @map("skipped")
  CANCELED  @map("canceled")

  @@map("node_run_status")
}

enum RunMode {
  REAL @map("real")
  TEST @map("test")

  @@map("run_mode")
}

enum TriggerType {
  MANUAL  @map("manual")
  CRON    @map("cron")
  WEBHOOK @map("webhook")

  @@map("trigger_type")
}

enum IdempotencyStatus {
  IN_FLIGHT @map("in_flight")
  COMPLETED @map("completed")

  @@map("idempotency_status")
}

enum RunEventLevel {
  INFO  @map("info")
  WARN  @map("warn")
  ERROR @map("error")

  @@map("run_event_level")
}

enum NodeWaitStatus {
  PENDING  @map("pending")
  RESOLVED @map("resolved")
  EXPIRED  @map("expired")

  @@map("node_wait_status")
}

// ===== 流程定义 =====

model Workflow {
  id               String    @id @default(cuid())
  name             String
  slug             String    @unique
  ownerId          String    @map("owner_id") // 学号快照，无外键
  draft            Json      @db.JsonB
  draftRevision    Int       @default(1) @map("draft_revision")
  publishedVersion Int?      @map("published_version")
  archivedAt       DateTime? @map("archived_at") @db.Timestamptz(3)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  versions WorkflowVersion[]
  runs     Run[]
  triggers Trigger[]

  @@map("workflows")
}

model WorkflowVersion {
  id         String   @id @default(cuid())
  workflowId String   @map("workflow_id")
  version    Int
  dsl        Json     @db.JsonB
  yaml       String
  layout     Json     @db.JsonB
  hash       String
  createdBy  String?  @map("created_by") // 学号快照，无外键
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  workflow Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  runs     Run[]

  @@unique([workflowId, version])
  @@map("workflow_versions")
}

model Connector {
  id        String   // 全名 = {id}.{actionKey}
  version   Int
  kind      String // 首版仅 http
  manifest  Json     @db.JsonB // 含 actions / triggers
  createdBy String?  @map("created_by")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@id([id, version])
  @@map("connectors")
}

// ===== 运行 =====

model Run {
  id              String    @id @default(cuid())
  workflowId      String    @map("workflow_id")
  versionId       String    @map("version_id")
  mode            RunMode
  status          RunStatus @default(QUEUED)
  trigger         Json      @db.JsonB
  triggeredBy     String?   @map("triggered_by")
  triggeredByName String?   @map("triggered_by_name") // 姓名快照
  inputs          Json      @db.JsonB
  vars            Json      @db.JsonB
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  startedAt       DateTime? @map("started_at") @db.Timestamptz(3)
  finishedAt      DateTime? @map("finished_at") @db.Timestamptz(3)
  heartbeatAt     DateTime? @map("heartbeat_at") @db.Timestamptz(3)
  durationMs      Int?      @map("duration_ms")
  waitedMs        Int?      @map("waited_ms")
  error           Json?     @db.JsonB
  eventSeq        Int       @default(0) @map("event_seq") // 事件序号分配器，见 RunEvent 注释

  workflow Workflow        @relation(fields: [workflowId], references: [id])
  version  WorkflowVersion @relation(fields: [versionId], references: [id])
  nodes    NodeRun[]
  events   RunEvent[]
  waits    NodeWait[]

  @@index([workflowId, createdAt(sort: Desc)])
  @@index([status, heartbeatAt])
  @@index([versionId])
  @@index([status, createdAt])
  @@map("runs")
}

model NodeRun {
  id         String        @id @default(cuid())
  runId      String        @map("run_id")
  nodeId     String        @map("node_id")
  attempt    Int           @default(1)
  status     NodeRunStatus @default(PENDING)
  input      Json?         @db.JsonB
  output     Json?         @db.JsonB
  outputRef  String?       @map("output_ref") // 正文 > 256KB 时进对象存储
  error      Json?         @db.JsonB
  startedAt  DateTime?     @map("started_at") @db.Timestamptz(3)
  finishedAt DateTime?     @map("finished_at") @db.Timestamptz(3)
  waitedMs   Int?          @map("waited_ms")

  run Run @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@unique([runId, nodeId, attempt])
  @@map("node_runs")
}

// 分区表：物理表由手写 SQL 迁移创建（PARTITION BY RANGE (ts)）。
// 分区键必须进主键，故主键为 (id, ts)。
model RunEvent {
  id      BigInt        @default(autoincrement())
  runId   String        @map("run_id")
  seq     Int
  ts      DateTime      @db.Timestamptz(3)
  level   RunEventLevel
  nodeId  String?       @map("node_id")
  type    String
  message String?
  data    Json?         @db.JsonB

  run Run @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@id([id, ts])
  // 分区表的唯一索引必须包含分区键 ts，(runId, seq, ts) 并不能阻止同一 run 写入重复 seq
  // （ts 不同就是不同行）。run 内唯一性改由 runs.event_seq 原子分配保证，
  // 这里只保留普通索引，供断点续传按 seq 增量拉取。
  @@index([runId, seq])
  @@index([runId, ts(sort: Desc)])
  @@map("run_events")
}

// ===== 密钥与触发器 =====

model Secret {
  name       String   @id
  cipher     Bytes // AES-256-GCM 密文
  nonce      Bytes // 每次加密随机 12 字节
  keyVersion Int      @map("key_version")
  createdBy  String?  @map("created_by")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("secrets")
}

model Trigger {
  id         String      @id @default(cuid())
  workflowId String      @map("workflow_id")
  type       TriggerType
  config     Json        @db.JsonB
  enabled    Boolean     @default(true)
  nextRunAt  DateTime?   @map("next_run_at") @db.Timestamptz(3)
  createdAt  DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)

  workflow Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)

  @@index([workflowId])
  @@index([enabled, nextRunAt])
  @@map("triggers")
}

// ===== 审计与幂等 =====

// 分区表：物理表由手写 SQL 迁移创建（PARTITION BY RANGE (ts)），主键为 (id, ts)。
model AuditLog {
  id         BigInt   @default(autoincrement())
  actorId    String?  @map("actor_id")
  actorName  String?  @map("actor_name") // 姓名快照
  action     String
  targetType String   @map("target_type")
  targetId   String   @map("target_id")
  before     Json?    @db.JsonB
  after      Json?    @db.JsonB
  ip         String?
  ts         DateTime @default(now()) @db.Timestamptz(3)

  @@id([id, ts])
  @@index([targetType, targetId, ts(sort: Desc)])
  @@map("audit_logs")
}

model IdempotencyKey {
  scope       String            // 'user:<sub>' / 'service:<client_id>'
  key         String            // sha256(Idempotency-Key) hex
  requestHash String            @map("request_hash") // 同键不同 body 时拒绝
  status      IdempotencyStatus @default(IN_FLIGHT)
  response    Json?             @db.JsonB
  exp         DateTime          @db.Timestamptz(3)
  createdAt   DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)

  @@id([scope, key])
  @@index([exp])
  @@map("idempotency_keys")
}

// ===== 通用异步等待（§4.1.1 的落地补充）=====
// PRD §5.4 表清单缺此表，已确认首版建表，PRD 下次修订补齐。
model NodeWait {
  id             String    @id @default(cuid())
  runId          String    @map("run_id")
  nodeId         String    @map("node_id")
  attempt        Int
  connectorId    String    @map("connector_id")
  correlationId  String    @unique @map("correlation_id") // 回调随带，先到也能落位
  externalTaskId String?   @map("external_task_id")
  eventId        String?   @map("event_id")
  status         NodeWaitStatus
  result         Json?     @db.JsonB
  deadline       DateTime? @db.Timestamptz(3)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  resolvedAt     DateTime? @map("resolved_at") @db.Timestamptz(3)

  run Run @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@unique([connectorId, eventId]) // 回调去重
  @@index([runId])
  @@index([status, deadline])
  @@map("node_waits")
}
