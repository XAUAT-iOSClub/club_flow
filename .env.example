# 复制为 .env 后填写真实值。.env 已被 .gitignore 忽略，禁止提交。

# ===== 数据库（独立 PostgreSQL 实例，专库 clubflow）=====
DATABASE_URL="postgresql://clubflow:CHANGE_ME@127.0.0.1:5432/clubflow?schema=public"
# 集成测试专用库，测试会清写数据，必须与开发库分离
TEST_DATABASE_URL="postgresql://clubflow:CHANGE_ME@127.0.0.1:5432/clubflow_test?schema=public"

# ===== 身份：验官网 access token（RS256 + JWKS）=====
JWT_ISSUER="iOS Club of XAUAT"
JWT_AUDIENCE="iOS Club of XAUAT"
JWT_JWKS_URL="https://www.xauat.site/.well-known/access-token/jwks"

# ===== 凭证加密主密钥（AES-256-GCM，FR-12.3）=====
# 生成方式：node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
# 轮换期间用 CLUBFLOW_MASTER_KEY_PREVIOUS 保留上一代，供双版本解密
CLUBFLOW_MASTER_KEY=""
CLUBFLOW_MASTER_KEY_PREVIOUS=""

# ===== 服务 =====
PORT=8081
LOG_LEVEL=info
CORS_ORIGINS="https://www.xauat.site,http://localhost:5173"

# ===== 大输出对象存储（node 输出 > 256KB 时只存 output_ref）=====
COS_SECRET_ID=""
COS_SECRET_KEY=""
COS_BUCKET=""
COS_REGION=""
